<!DOCTYPE html>
<html lang="es" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AgroTwin Regional - Cuenca Maule Sur</title>
    <link rel="icon" type="image/png" href="assets/favicon.png">
    <link rel="shortcut icon" href="favicon.ico">
    <link rel="apple-touch-icon" href="assets/favicon.png">

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        obsidian: {
                            800: '#1e293b',
                            900: '#080c14',
                        },
                        panel: 'rgba(13, 19, 34, 0.95)',
                    },
                    fontFamily: {
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace'],
                    },
                    boxShadow: {
                        glass: '0 25px 50px -12px rgba(0, 0, 0, 0.6)',
                    }
                }
            }
        }
    </script>

    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;700;800&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">

    <!-- Leaflet CSS & JS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        body {
            margin: 0;
            padding: 0;
            background-color: #080c14;
            color: #f1f5f9;
            overflow: hidden;
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        #map {
            position: absolute;
            top: 3.5rem; /* Header height */
            bottom: 2rem; /* Status bar height */
            left: 0;
            right: 0;
            z-index: 10;
        }

        /* UI Overlays */
        .glass-panel {
            background-color: rgba(13, 19, 34, 0.95);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.6);
        }

        /* Sidebar Tabs */
        .tab-content {
            display: none;
        }
        .tab-content.active {
            display: block;
            animation: fadeIn 0.3s ease-out;
        }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(5px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Leaflet Customizations */
        .leaflet-control-container .leaflet-routing-container-hide {
            display: none;
        }
        
        .pulse-marker {
            background: #10b981;
            border-radius: 50%;
            height: 12px;
            width: 12px;
            position: absolute;
            left: 50%;
            top: 50%;
            transform: translate(-50%, -50%);
            box-shadow: 0 0 0 rgba(16, 185, 129, 0.4);
            animation: pulse 2.5s infinite;
            border: 2px solid white;
        }
        .pulse-marker.water { background: #0ea5e9; box-shadow: 0 0 0 rgba(14, 165, 233, 0.4); }
        .pulse-marker.dmc { background: #f59e0b; box-shadow: 0 0 0 rgba(245, 158, 11, 0.4); }
        .pulse-marker.inia { background: #a855f7; box-shadow: 0 0 0 rgba(168, 85, 247, 0.4); }

        @keyframes pulse {
            0% {
                box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
            }
            70% {
                box-shadow: 0 0 0 15px rgba(16, 185, 129, 0);
            }
            100% {
                box-shadow: 0 0 0 0 rgba(16, 185, 129, 0);
            }
        }

        /* Scrollbar */
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: rgba(0,0,0,0.2); }
        ::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 3px; }
        ::-webkit-scrollbar-thumb:hover { background: rgba(255,255,255,0.2); }
        
        .data-mono { font-family: 'JetBrains Mono', monospace; }

        /* Range Sliders */
        input[type=range] {
            -webkit-appearance: none;
            width: 100%;
            background: transparent;
        }
        input[type=range]::-webkit-slider-thumb {
            -webkit-appearance: none;
            height: 16px; width: 16px;
            border-radius: 50%;
            background: #10b981;
            cursor: pointer;
            margin-top: -6px;
        }
        input[type=range]::-webkit-slider-runnable-track {
            width: 100%;
            height: 4px;
            cursor: pointer;
            background: rgba(255,255,255,0.2);
            border-radius: 2px;
        }
    </style>
</head>
<body>

    <!-- HEADER BAR -->
    <header class="fixed top-0 left-0 right-0 h-14 glass-panel z-50 flex items-center justify-between px-4 border-b border-white/10">
        <div class="flex items-center gap-4">
            <h1 class="text-emerald-500 font-extrabold text-lg tracking-wider">AGROTWIN <span class="text-white font-bold">REGIONAL</span></h1>
            <span class="text-xs bg-emerald-500/20 text-emerald-400 px-2 py-1 rounded border border-emerald-500/30">CUENCA MAULE SUR • 122K HA</span>
        </div>

        <div class="hidden xl:flex items-center gap-6 text-xs data-mono text-slate-300">
            <div class="flex flex-col"><span class="text-slate-500">Caudal Longaví</span><span class="text-sky-400 font-bold" id="hdr-caudal">124.5 m³/s</span></div>
            <div class="flex flex-col"><span class="text-slate-500">Humedad FDR</span><span class="text-emerald-400 font-bold" id="hdr-vwc">36.2%</span></div>
            <div class="flex flex-col"><span class="text-slate-500">Reserva Keyline</span><span class="text-sky-400 font-bold" id="hdr-vol">18,500 m³</span></div>
            <div class="flex flex-col"><span class="text-slate-500">Índice FWI</span><span class="text-amber-500 font-bold" id="hdr-fwi">24 (Bajo)</span></div>
            <div class="flex flex-col"><span class="text-slate-500">Hora UTC</span><span class="text-slate-100 font-bold" id="real-time-clock">--:--:--</span></div>
        </div>

        <div class="flex items-center gap-3">
            <button onclick="openModal()" class="bg-indigo-600 hover:bg-indigo-500 text-white text-xs px-4 py-2 rounded font-semibold transition-colors flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                Dossier Directorio
            </button>
            <button onclick="downloadFormalReport()" class="bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs px-3 py-2 rounded transition-colors border border-slate-600">
                PDF
            </button>
            <a href="http://localhost:7773" class="text-slate-400 hover:text-white text-xs underline px-2">:7773</a>
        </div>
    </header>

    <!-- MAP CONTAINER -->
    <div id="map"></div>

    <!-- SIDEBAR PANEL -->
    <div class="absolute right-0 top-14 bottom-8 w-full lg:w-[480px] glass-panel z-40 flex flex-col border-l border-white/10 transition-transform duration-300 shadow-2xl">
        
        <!-- Tab Navigation -->
        <div class="flex border-b border-white/10 bg-black/20 overflow-x-auto">
            <button class="tab-btn flex-1 py-3 px-2 text-[11px] font-semibold text-emerald-400 border-b-2 border-emerald-500 hover:bg-white/5 transition-colors whitespace-nowrap" data-target="tab-territory">📍 Territorio</button>
            <button class="tab-btn flex-1 py-3 px-2 text-[11px] font-semibold text-slate-400 border-b-2 border-transparent hover:bg-white/5 transition-colors whitespace-nowrap" data-target="tab-centinela">📡 Red Centinela</button>
            <button class="tab-btn flex-1 py-3 px-2 text-[11px] font-semibold text-slate-400 border-b-2 border-transparent hover:bg-white/5 transition-colors whitespace-nowrap" data-target="tab-investment">💼 Inversión</button>
            <button class="tab-btn flex-1 py-3 px-2 text-[11px] font-semibold text-slate-400 border-b-2 border-transparent hover:bg-white/5 transition-colors whitespace-nowrap" data-target="tab-fire">🔥 Piro-Riesgo</button>
            <button class="tab-btn flex-1 py-3 px-2 text-[11px] font-semibold text-slate-400 border-b-2 border-transparent hover:bg-white/5 transition-colors whitespace-nowrap" data-target="tab-water">💧 Hídrico</button>
            <button class="tab-btn flex-1 py-3 px-2 text-[11px] font-semibold text-slate-400 border-b-2 border-transparent hover:bg-white/5 transition-colors whitespace-nowrap" data-target="tab-architecture">🏛️ Arquitectura & API</button>
        </div>

        <!-- Scrollable Content Area -->
        <div class="flex-1 overflow-y-auto p-5">
            
            <!-- TAB: TERRITORIO -->
            <div id="tab-territory" class="tab-content active">
                <h2 class="text-sm text-slate-400 mb-4 font-semibold uppercase tracking-wider">Cobertura de Suelo (LULC)</h2>
                
                <div class="h-48 mb-6">
                    <canvas id="lulcChart"></canvas>
                </div>

                <div class="grid grid-cols-2 gap-4 mb-6">
                    <div class="bg-black/30 p-3 rounded border border-white/5">
                        <div class="text-[10px] text-slate-500 uppercase">Área Total Clasificada</div>
                        <div class="text-lg font-bold text-slate-200 data-mono">122,070 ha</div>
                    </div>
                    <div class="bg-black/30 p-3 rounded border border-white/5">
                        <div class="text-[10px] text-slate-500 uppercase">Última Pasada S2</div>
                        <div class="text-lg font-bold text-emerald-400 data-mono">2026-09-21</div>
                    </div>
                </div>

                <div class="space-y-2" id="layer-toggles">
                    <!-- Populated by JS -->
                </div>

                <h2 class="text-sm text-slate-400 mt-8 mb-4 font-semibold uppercase tracking-wider">Vistas Predefinidas</h2>
                <div class="grid grid-cols-2 gap-2">
                    <button class="bg-slate-800/50 hover:bg-emerald-900/40 border border-slate-700 hover:border-emerald-500/50 p-2 rounded text-xs text-left transition-colors" onclick="flyTo(-36.21156, -71.60530, 15)">Fundo Meniel (Keyline)</button>
                    <button class="bg-slate-800/50 hover:bg-emerald-900/40 border border-slate-700 hover:border-emerald-500/50 p-2 rounded text-xs text-left transition-colors" onclick="flyTo(-36.2800, -71.4200, 13)">Embalse Bullileo</button>
                    <button class="bg-slate-800/50 hover:bg-emerald-900/40 border border-slate-700 hover:border-emerald-500/50 p-2 rounded text-xs text-left transition-colors" onclick="flyTo(-36.1432, -71.8267, 14)">Parral Centro</button>
                    <button class="bg-slate-800/50 hover:bg-emerald-900/40 border border-slate-700 hover:border-emerald-500/50 p-2 rounded text-xs text-left transition-colors" onclick="flyTo(-36.0500, -71.7667, 14)">Retiro Pueblo</button>
                    <button class="bg-slate-800/50 hover:bg-emerald-900/40 border border-slate-700 hover:border-emerald-500/50 p-2 rounded text-xs text-left transition-colors" onclick="flyTo(-36.1300, -71.6500, 11)">Vista General Cuenca</button>
                    <button class="bg-slate-800/50 hover:bg-emerald-900/40 border border-slate-700 hover:border-emerald-500/50 p-2 rounded text-xs text-left transition-colors" onclick="flyTo(-36.1800, -71.6400, 14)">Río Longaví Crossing</button>
                </div>
            </div>

            <!-- TAB: INVERSION -->
            <div id="tab-investment" class="tab-content">
                 <h2 class="text-sm text-slate-400 mb-4 font-semibold uppercase tracking-wider">Tesis Financiera Fundo Meniel</h2>
                 
                 <div class="grid grid-cols-2 gap-3 mb-6">
                    <div class="bg-black/30 p-3 rounded border border-white/5">
                        <div class="text-[10px] text-slate-500 uppercase">CAPEX Inicial</div>
                        <div class="text-lg font-bold text-red-400 data-mono">$48.5M</div>
                    </div>
                    <div class="bg-black/30 p-3 rounded border border-white/5">
                        <div class="text-[10px] text-slate-500 uppercase">TIR Proyectada</div>
                        <div class="text-lg font-bold text-emerald-400 data-mono">18.6%</div>
                    </div>
                    <div class="bg-black/30 p-3 rounded border border-white/5">
                        <div class="text-[10px] text-slate-500 uppercase">Payback</div>
                        <div class="text-lg font-bold text-sky-400 data-mono">3.8 Años</div>
                    </div>
                    <div class="bg-black/30 p-3 rounded border border-white/5">
                        <div class="text-[10px] text-slate-500 uppercase">Ahorro Bombeo/Año</div>
                        <div class="text-lg font-bold text-emerald-400 data-mono">-$8.2M</div>
                    </div>
                 </div>

                 <div class="bg-emerald-900/20 border border-emerald-500/30 rounded p-4 mb-6">
                     <div class="text-xs text-emerald-400 font-bold mb-1">PÉRDIDA EVITADA (Riesgo Megasequía)</div>
                     <div class="text-2xl font-black text-emerald-300 data-mono">$140,000,000 CLP</div>
                     <p class="text-[10px] text-slate-400 mt-2">Valor asegurado de huerto de cerezos basado en reservas hídricas en suelo profundo (Keyline).</p>
                 </div>

                 <h3 class="text-xs text-slate-400 mb-2 font-semibold">Proyección ROI (10 Años)</h3>
                 <div class="h-40 mb-6">
                     <canvas id="roiChart"></canvas>
                 </div>

                 <div class="bg-indigo-900/20 border border-indigo-500/30 rounded p-4">
                     <div class="text-xs text-indigo-400 font-bold mb-2">GOBERNANZA</div>
                     <ul class="text-[11px] text-slate-300 space-y-1">
                         <li>• <strong class="text-white">Meniel SpA:</strong> Vehículo de inversión de capital.</li>
                         <li>• <strong class="text-white">Cooperativa Agua Viva:</strong> Gestión comunitaria de excedentes.</li>
                         <li>• <strong class="text-white">MRV:</strong> Certificación de Carbono y Agua en Blockchain.</li>
                     </ul>
                 </div>
            </div>

            <!-- TAB: PIRO -->
            <div id="tab-fire" class="tab-content">
                 <h2 class="text-sm text-slate-400 mb-4 font-semibold uppercase tracking-wider">Simulador de Riesgo (FWI)</h2>

                 <div class="bg-black/40 p-4 rounded-lg border border-white/10 mb-6 relative overflow-hidden">
                     <div class="absolute right-0 top-0 h-full w-2" id="fwi-indicator" style="background-color: #10b981;"></div>
                     <div class="text-[10px] text-slate-500 uppercase">Índice Fire Weather Index (Local)</div>
                     <div class="text-3xl font-black mt-1 flex items-baseline gap-2">
                         <span id="fwi-value" class="data-mono text-emerald-400">24</span>
                         <span id="fwi-label" class="text-xs font-bold text-emerald-400 px-2 py-0.5 bg-emerald-900/30 rounded">RIESGO BAJO</span>
                     </div>
                 </div>

                 <div class="space-y-5 mb-8">
                     <div>
                         <div class="flex justify-between text-xs mb-1">
                             <span class="text-slate-400">Temperatura Ambient (°C)</span>
                             <span class="text-white data-mono" id="val-temp">22 °C</span>
                         </div>
                         <input type="range" id="slide-temp" min="20" max="44" value="22" oninput="updateFWI()">
                     </div>
                     <div>
                         <div class="flex justify-between text-xs mb-1">
                             <span class="text-slate-400">Humedad Relativa (%)</span>
                             <span class="text-white data-mono" id="val-hum">45 %</span>
                         </div>
                         <input type="range" id="slide-hum" min="8" max="60" value="45" oninput="updateFWI()">
                     </div>
                     <div>
                         <div class="flex justify-between text-xs mb-1">
                             <span class="text-slate-400">Viento Puelche (km/h)</span>
                             <span class="text-white data-mono" id="val-wind">15 km/h</span>
                         </div>
                         <input type="range" id="slide-wind" min="5" max="75" value="15" oninput="updateFWI()">
                     </div>
                 </div>

                 <h3 class="text-xs text-slate-400 mb-2 font-semibold">Comparativa de Vulnerabilidad (FWI)</h3>
                 <div class="h-32 mb-6">
                     <canvas id="fwiChart"></canvas>
                 </div>

                 <div class="bg-emerald-900/20 border border-emerald-500/30 rounded p-3 flex items-start gap-3">
                     <div class="text-2xl pt-1">🌳</div>
                     <div>
                         <div class="text-xs text-emerald-400 font-bold">Cortafuego Verde Activo</div>
                         <div class="text-[11px] text-slate-300 mt-1">Línea Keyline Sur perimetral: 2.4 km de especies nativas (Peumo/Quillay) hidratadas al 37% VWC. Reduce la velocidad de propagación un 64%.</div>
                     </div>
                 </div>
            </div>

            <!-- TAB: HIDRICO -->
            <div id="tab-water" class="tab-content">
                <h2 class="text-sm text-slate-400 mb-4 font-semibold uppercase tracking-wider">Seguridad Hídrica</h2>

                <div class="grid grid-cols-2 gap-3 mb-6">
                    <div class="bg-black/30 p-3 rounded border border-white/5">
                        <div class="text-[10px] text-slate-500 uppercase">Infiltración</div>
                        <div class="text-lg font-bold text-sky-400 data-mono">320 L/s</div>
                    </div>
                    <div class="bg-black/30 p-3 rounded border border-white/5">
                        <div class="text-[10px] text-slate-500 uppercase">Atenuación Crecida</div>
                        <div class="text-lg font-bold text-emerald-400 data-mono">-3.2%</div>
                    </div>
                    <div class="bg-black/30 p-3 rounded border border-white/5 col-span-2">
                        <div class="text-[10px] text-slate-500 uppercase flex justify-between">
                            <span>Autonomía Tranque Keyline</span>
                            <span class="text-emerald-400 font-bold">100% Operativo</span>
                        </div>
                        <div class="text-2xl font-black text-white mt-1 data-mono">42 Días</div>
                    </div>
                </div>

                <div class="space-y-5 mb-8">
                     <div>
                         <div class="flex justify-between text-xs mb-1">
                             <span class="text-slate-400">Precipitación 24h (mm)</span>
                             <span class="text-white data-mono" id="val-precip">0 mm</span>
                         </div>
                         <input type="range" id="slide-precip" min="10" max="220" value="10" oninput="updateWater()">
                     </div>
                     <div>
                         <div class="flex justify-between text-xs mb-1">
                             <span class="text-slate-400">Caudal Base Longaví (m³/s)</span>
                             <span class="text-white data-mono" id="val-flow">125 m³/s</span>
                         </div>
                         <input type="range" id="slide-flow" min="30" max="650" value="125" oninput="updateWater()">
                     </div>
                 </div>

                 <h3 class="text-xs text-slate-400 mb-2 font-semibold">Balance Hídrico Estacional (Simulado)</h3>
                 <div class="h-40">
                     <canvas id="waterChart"></canvas>
                 </div>
            </div>

            <!-- TAB: RED CENTINELA & MODELAMIENTO ATMOSFÉRICO -->
            <div id="tab-centinela" class="tab-content space-y-6">
                <div>
                    <div class="flex items-center justify-between mb-1">
                        <h2 class="text-sm text-slate-300 font-bold uppercase tracking-wider flex items-center gap-2">
                            <span>📡</span> Red Centinela Ground-Truth Mesh
                        </h2>
                        <span class="text-[10px] bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 px-2 py-0.5 rounded font-mono font-bold">
                            9 Estaciones Enlazadas
                        </span>
                    </div>
                    <p class="text-[11px] text-slate-400 leading-relaxed">
                        Integración de la micromalla IoT KioT in situ con la red meteorológica y fluviométrica pública del Estado (DMC, DGA, INIA).
                    </p>
                </div>

                <!-- Grid de Nodos de la Red Centinela -->
                <div class="space-y-3">
                    <div class="text-[11px] font-bold text-sky-400 uppercase tracking-wider font-mono flex items-center gap-1.5">
                        <span>🔹</span> Malla IoT KioT • Fundo Meniel (Predial)
                    </div>
                    <div class="grid grid-cols-1 gap-2 text-xs font-mono">
                        <div class="p-3 bg-black/40 border border-emerald-500/30 rounded-lg flex items-center justify-between">
                            <div>
                                <strong class="text-emerald-300 block">FDR-01 Cerezos (0-20 cm)</strong>
                                <span class="text-[10px] text-slate-400">36.2% VWC • Bat 92% • LQI 98%</span>
                            </div>
                            <button onclick="flyTo(-36.2095, -71.6060, 16)" class="px-2.5 py-1 bg-emerald-950 hover:bg-emerald-900 border border-emerald-500/40 rounded text-[10px] text-emerald-300 font-sans transition-colors">
                                Ver 🔍
                            </button>
                        </div>
                        <div class="p-3 bg-black/40 border border-emerald-500/30 rounded-lg flex items-center justify-between">
                            <div>
                                <strong class="text-emerald-300 block">FDR-02 Avellano (20-60 cm)</strong>
                                <span class="text-[10px] text-slate-400">34.8% VWC • Bat 88% • LQI 95%</span>
                            </div>
                            <button onclick="flyTo(-36.2120, -71.6030, 16)" class="px-2.5 py-1 bg-emerald-950 hover:bg-emerald-900 border border-emerald-500/40 rounded text-[10px] text-emerald-300 font-sans transition-colors">
                                Ver 🔍
                            </button>
                        </div>
                        <div class="p-3 bg-black/40 border border-emerald-500/30 rounded-lg flex items-center justify-between">
                            <div>
                                <strong class="text-emerald-300 block">FDR-03 Keyline Sur (Infiltración)</strong>
                                <span class="text-[10px] text-slate-400">37.1% VWC • Bat 95% • Infiltración Activa</span>
                            </div>
                            <button onclick="flyTo(-36.2145, -71.6050, 16)" class="px-2.5 py-1 bg-emerald-950 hover:bg-emerald-900 border border-emerald-500/40 rounded text-[10px] text-emerald-300 font-sans transition-colors">
                                Ver 🔍
                            </button>
                        </div>
                        <div class="p-3 bg-black/40 border border-emerald-500/30 rounded-lg flex items-center justify-between">
                            <div>
                                <strong class="text-emerald-300 block">FDR-04 Pastura & Ganado (Silvopastoril)</strong>
                                <span class="text-[10px] text-slate-400">35.0% VWC • Bat 90% • Zona PRV</span>
                            </div>
                            <button onclick="flyTo(-36.2105, -71.6080, 16)" class="px-2.5 py-1 bg-emerald-950 hover:bg-emerald-900 border border-emerald-500/40 rounded text-[10px] text-emerald-300 font-sans transition-colors">
                                Ver 🔍
                            </button>
                        </div>
                        <div class="p-3 bg-black/40 border border-sky-500/30 rounded-lg flex items-center justify-between">
                            <div>
                                <strong class="text-sky-300 block">Piezómetro Tranque Meniel</strong>
