http.get('http://127.0.0.1:7774/api/telemetry/summary', { timeout: 1200 }, (res) => {
  let data = '';
  res.on('data', c => data += c);
  res.on('end', () => {
    const regional = JSON.parse(data);
    // Inyecta condiciones de cuenca en Fundo Meniel 3D
    serveLiveBoundaryConditions(regional);
  });
});</code></pre>
