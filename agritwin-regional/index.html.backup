        // Base Layers con Google Maps y Caché Local Offline
        const googleHybrid = L.tileLayer('/api/tiles/google-hybrid/{z}/{x}/{y}.png', {
            attribution: '&copy; Google Maps Satélite + Rutas (Caché Local Offline)',
            maxZoom: 20
        });

        const googleSat = L.tileLayer('/api/tiles/google-sat/{z}/{x}/{y}.png', {
            attribution: '&copy; Google Maps Satélite HD',
            maxZoom: 20
        });

        const googleTerrain = L.tileLayer('/api/tiles/google-terrain/{z}/{x}/{y}.png', {
            attribution: '&copy; Google Maps Relieve Topográfico',
            maxZoom: 20
        });

        const googleStreets = L.tileLayer('/api/tiles/google-streets/{z}/{x}/{y}.png', {
            attribution: '&copy; Google Maps Calles',
            maxZoom: 20
        });

        const darkTactical = L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
            attribution: '&copy; CARTO &copy; OpenStreetMap'
        });

        const esriSat = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
            attribution: 'Tiles &copy; Esri'
        });

        const baseLayers = {
            "🛰️ Google Maps Híbrido": googleHybrid,
            "🌍 Google Maps Satélite": googleSat,
            "🏔️ Google Maps Terreno": googleTerrain,
            "🗺️ Google Maps Calles": googleStreets,
            "🕶️ Táctico Oscuro": darkTactical,
            "🛰️ Satélite ESRI": esriSat
        };

        // Activar Google Maps Híbrido por defecto
        googleHybrid.addTo(map);

        L.control.layers(baseLayers, null, { position: 'topleft', collapsed: false }).addTo(map);

        // Map Layers Object to hold references
        const overlayLayers = {};

        // 2.1 Mosaico Catastral Predial Rural (Roles SII)
        const prediosLayer = L.geoJSON(geojsonPredios, {
            style: function(feature) {
                return {
                    color: feature.properties.stroke || '#10b981',
                    weight: 2,
                    opacity: 0.9,
                    fillColor: feature.properties.color || '#10b981',
                    fillOpacity: 0.35
                };
            },
            onEachFeature: function(feature, layer) {
                const p = feature.properties;
                layer.on('mouseover', function() { this.setStyle({ fillOpacity: 0.6, weight: 3 }); });
                layer.on('mouseout', function() { this.setStyle({ fillOpacity: 0.35, weight: 2 }); });

                const popupHtml = `
                    <div style="font-family: 'JetBrains Mono', monospace; font-size: 11px; min-width: 240px; padding: 2px;">
                        <div style="display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid #334155; padding-bottom: 4px; margin-bottom: 6px;">
                            <strong style="color: ${p.color}; font-size: 12px;">${p.name}</strong>
                        </div>
                        <div style="display: flex; justify-content: space-between; margin-bottom: 3px;">
                            <span style="color: #94a3b8;">Rol SII:</span>
                            <span style="color: #f8fafc; font-weight: bold; background: rgba(255,255,255,0.1); padding: 1px 4px; border-radius: 3px;">${p.rol}</span>
                        </div>
                        <div style="display: flex; justify-content: space-between; margin-bottom: 3px;">
                            <span style="color: #94a3b8;">Superficie:</span>
                            <span style="color: #38bdf8; font-weight: bold;">${p.area_ha} ha</span>
                        </div>
                        <div style="margin-bottom: 4px;">
                            <span style="color: #94a3b8; display: block; font-size: 10px;">Cultivo / Cobertura:</span>
                            <span style="color: #cbd5e1; font-size: 10px;">${p.crop}</span>
                        </div>
                        <div style="display: flex; justify-content: space-between; margin-bottom: 3px;">
                            <span style="color: #94a3b8;">Derechos DGA:</span>
                            <span style="color: #0ea5e9; font-weight: bold;">${p.water_L_s} L/s</span>
                        </div>
                        <div style="display: flex; justify-content: space-between; margin-bottom: 3px;">
                            <span style="color: #94a3b8;">Humedad FDR:</span>
                            <span style="color: #10b981; font-weight: bold;">${p.vwc}</span>
                        </div>
                        <div style="display: flex; justify-content: space-between; margin-bottom: 3px;">
                            <span style="color: #94a3b8;">FWI Riesgo:</span>
                            <span style="color: ${p.fwi > 50 ? '#ef4444' : (p.fwi > 30 ? '#f59e0b' : '#10b981')}; font-weight: bold;">${p.fwi} (${p.fwi_status})</span>
                        </div>
                        <div style="border-top: 1px solid #1e293b; padding-top: 4px; margin-top: 4px; font-size: 9px; color: #64748b;">
                            Propietario: ${p.owner}
                        </div>
                    </div>
                `;
                layer.bindPopup(popupHtml);
            }
        });
        overlayLayers['predios'] = prediosLayer;
        prediosLayer.addTo(map);

        // 2.2 Zonificación de Amenaza de Inundación Fluvial (DGA / SENAPRED)
        const inundacionLayer = L.geoJSON(geojsonInundacion, {
            style: function(feature) {
                const p = feature.properties;
                return {
                    color: p.color,
                    weight: 2,
                    dashArray: '4, 4',
                    fillColor: p.color,
                    fillOpacity: p.fillOpacity
                };
            },
            onEachFeature: function(feature, layer) {
                const p = feature.properties;
                const popupHtml = `
                    <div style="font-family: 'JetBrains Mono', monospace; font-size: 11px; min-width: 250px; padding: 2px;">
                        <div style="display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid #0369a1; padding-bottom: 4px; margin-bottom: 6px;">
                            <strong style="color: ${p.color}; font-size: 12px;">🌊 ${p.recurrence}</strong>
                        </div>
                        <div style="margin-bottom: 4px;">
                            <span style="color: #94a3b8; font-size: 10px;">Caudal Umbral:</span>
                            <span style="color: #38bdf8; font-weight: bold;">&gt; ${p.caudal_critico}</span>
                        </div>
                        <div style="margin-bottom: 4px;">
                            <span style="color: #94a3b8; font-size: 10px;">Cota Máx:</span>
                            <span style="color: #f8fafc; font-weight: bold;">${p.cota_max}</span>
                        </div>
                        <p style="color: #cbd5e1; font-size: 10px; margin: 4px 0;">${p.descripcion}</p>
                        <div style="background: rgba(14, 165, 233, 0.1); border-left: 2px solid ${p.color}; padding: 4px; font-size: 9px; color: #bae6fd;">
                            Afectación: ${p.afectacion}
                        </div>
                    </div>
                `;
                layer.bindPopup(popupHtml);
            }
        });
        overlayLayers['inundacion'] = inundacionLayer;
        inundacionLayer.addTo(map);

        // 2.3 Zonificación Pirogénica de Paisaje (CONAF / FWI)
        const incendiosLayer = L.geoJSON(geojsonIncendios, {
            style: function(feature) {
                const p = feature.properties;
                return {
                    color: p.color,
                    weight: 2,
                    fillColor: p.color,
                    fillOpacity: p.fillOpacity
                };
            },
            onEachFeature: function(feature, layer) {
                const p = feature.properties;
                const popupHtml = `
                    <div style="font-family: 'JetBrains Mono', monospace; font-size: 11px; min-width: 250px; padding: 2px;">
                        <div style="display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid #b91c1c; padding-bottom: 4px; margin-bottom: 6px;">
                            <strong style="color: ${p.color}; font-size: 12px;">🔥 ${p.zona}</strong>
                        </div>
                        <div style="display: flex; justify-content: space-between; margin-bottom: 3px;">
                            <span style="color: #94a3b8;">Nivel Peligro:</span>
                            <span style="color: ${p.color}; font-weight: bold;">${p.peligro}</span>
                        </div>
                        <div style="margin-bottom: 4px;">
                            <span style="color: #94a3b8; font-size: 10px;">Factor Crítico:</span>
                            <p style="color: #cbd5e1; font-size: 10px; margin: 2px 0;">${p.factor}</p>
                        </div>
                        <div style="font-size: 9px; color: #94a3b8;">
                            Especies: ${p.especies}
                        </div>
                    </div>
                `;
                layer.bindPopup(popupHtml);
            }
        });
        overlayLayers['incendios'] = incendiosLayer;
        incendiosLayer.addTo(map);

        // 2.4 Comités de Agua Potable Rural (APRs)
        const aprLayerGroup = L.layerGroup();
        aprsData.forEach(apr => {
            const aprIcon = L.divIcon({
                className: 'custom-div-icon',
                html: `<div style="background: #0284c7; border: 2px solid white; border-radius: 50%; width: 14px; height: 14px; box-shadow: 0 0 10px rgba(14, 165, 233, 0.9);"></div>`,
                iconSize: [16, 16]
            });
            const aprPopup = `
                <div style="font-family: 'JetBrains Mono', monospace; font-size: 11px; min-width: 220px; padding: 2px;">
                    <div style="border-bottom: 1px solid #0369a1; padding-bottom: 4px; margin-bottom: 4px;">
                        <strong style="color: #38bdf8; font-size: 12px;">🚰 ${apr.name}</strong>
                    </div>
                    <div style="display: flex; justify-content: space-between; margin-bottom: 3px;">
                        <span style="color: #94a3b8;">Familias:</span>
                        <span style="color: #f8fafc; font-weight: bold;">${apr.familias.toLocaleString()}</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; margin-bottom: 3px;">
                        <span style="color: #94a3b8;">Pozo Profundo:</span>
                        <span style="color: #38bdf8;">${apr.pozo_prof_m} m</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; margin-bottom: 3px;">
                        <span style="color: #94a3b8;">Caudal Bombeo:</span>
                        <span style="color: #0ea5e9; font-weight: bold;">${apr.bombeo_L_s} L/s</span>
                    </div>
                    <div style="font-size: 9px; color: #cbd5e1; margin-top: 4px; background: rgba(0,0,0,0.3); padding: 3px; border-radius: 3px;">
                        Estado: ${apr.vulnerabilidad}
                    </div>
                </div>
            `;
            L.marker([apr.lat, apr.lng], { icon: aprIcon }).bindPopup(aprPopup).addTo(aprLayerGroup);
        });
        overlayLayers['aprs'] = aprLayerGroup;
        aprLayerGroup.addTo(map);

        // 2.5 Capas WMS Institucionales Oficiales (IDE Minagri & CONAF)
        const wmsMinagri = L.tileLayer.wms('https://ide.minagri.gob.cl/geoserver/wms', {
            layers: 'ciren:catastro_fruticola',
            format: 'image/png',
            transparent: true,
            opacity: 0.65,
            attribution: 'IDE Minagri / CIREN'
        });
        overlayLayers['wms_minagri'] = wmsMinagri;

        const wmsConaf = L.tileLayer.wms('https://sit.conaf.cl/geoserver/wms', {
            layers: 'conaf:snaspe_areas',
            format: 'image/png',
            transparent: true,
            opacity: 0.65,
            attribution: 'CONAF SIT'
        });
        overlayLayers['wms_conaf'] = wmsConaf;

        // 2.2 Add Rivers
        const riverLayerGroup = L.layerGroup();
        rivers.forEach(r => {
            L.polyline(r.coords, { color: r.color, weight: 3, opacity: 0.8 }).bindPopup(r.name).addTo(riverLayerGroup);
        });
        riverLayerGroup.addTo(map);
        overlayLayers['rivers'] = riverLayerGroup;

        // 2.3 Add Fundo Meniel Polygon
        const menielLayer = L.polygon(fundoMenielCoords, {
            color: '#10b981',
            weight: 3,
            fillColor: '#10b981',
            fillOpacity: 0.2
        }).bindPopup("<b>Fundo Meniel</b><br>24.8 ha<br>Proyecto Keyline").addTo(map);
        overlayLayers['meniel'] = menielLayer;

        // 2.4 Add Sensors & Ground-Truth Meteorological Mesh
        const sensorLayerGroup = L.layerGroup();
        sensors.forEach(s => {
            let markerClass = 'pulse-marker';
            if (s.type === 'water') markerClass = 'pulse-marker water';
            else if (s.type === 'dmc') markerClass = 'pulse-marker dmc';
            else if (s.type === 'inia') markerClass = 'pulse-marker inia';

            const customIcon = L.divIcon({
                className: 'custom-div-icon',
                html: `<div class="${markerClass}"></div>`,
                iconSize: [20, 20]
            });

            const popupContent = `
                <div style="font-family: 'JetBrains Mono', monospace; font-size: 11px; padding: 2px;">
                    <div style="display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid #334155; padding-bottom: 4px; margin-bottom: 4px;">
                        <strong style="color: #10b981; font-size: 12px;">${s.name}</strong>
                    </div>
                    <span style="display: inline-block; padding: 2px 6px; border-radius: 4px; background: rgba(0,0,0,0.4); color: #94a3b8; font-size: 9px; margin-bottom: 4px;">Red: ${s.network || 'KioT Mesh'}</span>
                    <div style="color: #cbd5e1; margin-top: 2px;">${s.data}</div>
                    <div style="font-size: 9px; color: #64748b; margin-top: 4px;">WGS84: ${s.lat.toFixed(4)}, ${s.lng.toFixed(4)}</div>
                </div>
            `;

            L.marker([s.lat, s.lng], { icon: customIcon })
             .bindPopup(popupContent)
             .addTo(sensorLayerGroup);
        });
        sensorLayerGroup.addTo(map);
        overlayLayers['sensors'] = sensorLayerGroup;


        // Map Events for Status Bar
        map.on('mousemove', function(e) {
            document.getElementById('cursor-coords').innerText = `Lat: ${e.latlng.lat.toFixed(5)}, Lng: ${e.latlng.lng.toFixed(5)}`;
        });
        map.on('zoomend', function() {
            document.getElementById('zoom-level').innerText = `Zoom: ${map.getZoom()}`;
        });

        // FlyTo Function
        function flyTo(lat, lng, zoom) {
            map.flyTo([lat, lng], zoom, {
                duration: 1.5
            });
        }

        // Layer Toggling Function
        function toggleLayer(layerId, checkbox) {
            const layer = overlayLayers[layerId];
            if (!layer) return;
            if (checkbox.checked) {
                map.addLayer(layer);
            } else {
                map.removeLayer(layer);
            }
        }


        // --- 3. UI INITIALIZATION & LOGIC ---

        // Real-time Clock
        function updateClock() {
            const now = new Date();
            document.getElementById('real-time-clock').innerText = now.toISOString().substr(11, 8);
        }
        setInterval(updateClock, 1000);
        updateClock();

        // Tabs Logic
        document.querySelectorAll('.tab-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                // Remove active classes
                document.querySelectorAll('.tab-btn').forEach(b => {
                    b.classList.remove('text-emerald-400', 'border-emerald-500');
                    b.classList.add('text-slate-400', 'border-transparent');
                });
                document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
                
                // Add active to clicked
                btn.classList.add('text-emerald-400', 'border-emerald-500');
                btn.classList.remove('text-slate-400', 'border-transparent');
                document.getElementById(btn.dataset.target).classList.add('active');
            });
        });

        // Populate Layer Toggles
        const toggleContainer = document.getElementById('layer-toggles');
        toggleContainer.innerHTML = `
            <div class="space-y-4">
                <!-- SECCIÓN 1: CATASTRO & PREDIOS -->
                <div>
                    <div class="text-[10px] font-bold text-emerald-400 uppercase tracking-wider mb-2 flex items-center gap-1.5 font-mono">
                        <span>🏡</span> Mosaico Predial Comunal (Roles SII)
                    </div>
                    <label class="flex items-center justify-between p-2.5 rounded bg-black/30 hover:bg-white/5 cursor-pointer border border-emerald-500/20 transition-colors">
                        <div class="flex items-center gap-3">
                            <input type="checkbox" checked onchange="toggleLayer('predios', this)" class="accent-emerald-500 w-4 h-4 cursor-pointer">
                            <div class="w-3 h-3 rounded bg-emerald-500"></div>
                            <div>
                                <span class="text-xs text-emerald-300 font-semibold block">Catastro Predial Completo</span>
                                <span class="text-[9px] text-slate-400">10 Predios • Retiro & Parral • Derechos DGA L/s</span>
                            </div>
                        </div>
                        <span class="text-[10px] text-emerald-400 data-mono font-bold">508 ha</span>
                    </label>
                </div>

                <!-- SECCIÓN 2: RIESGO DE INUNDACIÓN -->
                <div>
                    <div class="text-[10px] font-bold text-sky-400 uppercase tracking-wider mb-2 flex items-center gap-1.5 font-mono">
                        <span>🌊</span> Amenaza Inundación Fluvial (DGA / SENAPRED)
                    </div>
                    <label class="flex items-center justify-between p-2.5 rounded bg-black/30 hover:bg-white/5 cursor-pointer border border-sky-500/20 transition-colors">
                        <div class="flex items-center gap-3">
                            <input type="checkbox" checked onchange="toggleLayer('inundacion', this)" class="accent-sky-500 w-4 h-4 cursor-pointer">
                            <div class="w-3 h-3 rounded bg-sky-500"></div>
                            <div>
                                <span class="text-xs text-sky-300 font-semibold block">Manchas de Inundación (T=10, 50, 100)</span>
                                <span class="text-[9px] text-slate-400">Corredor Fluvial Río Longaví • Llanura Aluvial</span>
                            </div>
                        </div>
                        <span class="text-[10px] text-sky-400 data-mono font-bold">DGA/MOP</span>
                    </label>
                </div>

                <!-- SECCIÓN 3: RIESGO PIROGÉNICO -->
                <div>
                    <div class="text-[10px] font-bold text-amber-400 uppercase tracking-wider mb-2 flex items-center gap-1.5 font-mono">
                        <span>🔥</span> Peligro Pirogénico Paisajístico (CONAF / FWI)
                    </div>
                    <label class="flex items-center justify-between p-2.5 rounded bg-black/30 hover:bg-white/5 cursor-pointer border border-amber-500/20 transition-colors">
                        <div class="flex items-center gap-3">
                            <input type="checkbox" checked onchange="toggleLayer('incendios', this)" class="accent-amber-500 w-4 h-4 cursor-pointer">
                            <div class="w-3 h-3 rounded bg-red-500"></div>
                            <div>
                                <span class="text-xs text-red-300 font-semibold block">Zonificación Incendios & Cortafuegos</span>
                                <span class="text-[9px] text-slate-400">Interfaz Puelche vs Cortafuegos Vivos 25m</span>
                            </div>
                        </div>
                        <span class="text-[10px] text-amber-400 data-mono font-bold">CONAF</span>
                    </label>
                </div>

                <!-- SECCIÓN 4: INFRAESTRUCTURA HÍDRICA & APRs -->
                <div>
                    <div class="text-[10px] font-bold text-blue-400 uppercase tracking-wider mb-2 flex items-center gap-1.5 font-mono">
                        <span>🚰</span> Comités Agua Potable (APRs) & Red Hídrica
                    </div>
                    <div class="space-y-1.5">
                        <label class="flex items-center justify-between p-2 rounded bg-black/30 hover:bg-white/5 cursor-pointer border border-white/5 transition-colors">
                            <div class="flex items-center gap-3">
                                <input type="checkbox" checked onchange="toggleLayer('aprs', this)" class="accent-blue-500 w-4 h-4 cursor-pointer">
                                <div class="w-3 h-3 rounded-full bg-blue-500 border border-white"></div>
                                <span class="text-xs text-slate-300">5 Comités APR Comunales</span>
                            </div>
                            <span class="text-[10px] text-slate-400 data-mono">3,600 hab</span>
                        </label>
                        <label class="flex items-center justify-between p-2 rounded bg-black/30 hover:bg-white/5 cursor-pointer border border-white/5 transition-colors">
                            <div class="flex items-center gap-3">
                                <input type="checkbox" checked onchange="toggleLayer('rivers', this)" class="accent-sky-500 w-4 h-4 cursor-pointer">
                                <div class="w-3 h-3 rounded bg-sky-400"></div>
                                <span class="text-xs text-slate-300">Ríos Longaví, Perquilauquén & Canales</span>
                            </div>
                            <span class="text-[10px] text-slate-400 data-mono">Red DGA</span>
                        </label>
                        <label class="flex items-center justify-between p-2 rounded bg-black/30 hover:bg-white/5 cursor-pointer border border-white/5 transition-colors">
                            <div class="flex items-center gap-3">
                                <input type="checkbox" checked onchange="toggleLayer('sensors', this)" class="accent-emerald-500 w-4 h-4 cursor-pointer">
                                <div class="w-3 h-3 rounded-full bg-emerald-500 border border-white animate-pulse"></div>
                                <span class="text-xs text-slate-300">Red Centinela KioT Mesh (9 Nodos)</span>
                            </div>
                            <span class="text-[10px] text-emerald-400 data-mono">En Vivo</span>
                        </label>
                    </div>
                </div>

                <!-- SECCIÓN 5: CAPAS OFICIALES WMS -->
                <div>
                    <div class="text-[10px] font-bold text-purple-400 uppercase tracking-wider mb-2 flex items-center gap-1.5 font-mono">
                        <span>🏛️</span> Servicios WMS Oficiales del Estado (Chile)
                    </div>
                    <div class="space-y-1.5">
                        <label class="flex items-center justify-between p-2 rounded bg-black/30 hover:bg-white/5 cursor-pointer border border-purple-500/20 transition-colors">
                            <div class="flex items-center gap-3">
                                <input type="checkbox" onchange="toggleLayer('wms_minagri', this)" class="accent-purple-500 w-4 h-4 cursor-pointer">
                                <div class="w-3 h-3 rounded bg-purple-500"></div>
                                <span class="text-xs text-purple-300">IDE Minagri / CIREN (Catastro WMS)</span>
                            </div>
                            <span class="text-[9px] bg-purple-950 text-purple-300 px-1.5 py-0.5 rounded border border-purple-800">WMS</span>
                        </label>
                        <label class="flex items-center justify-between p-2 rounded bg-black/30 hover:bg-white/5 cursor-pointer border border-purple-500/20 transition-colors">
                            <div class="flex items-center gap-3">
                                <input type="checkbox" onchange="toggleLayer('wms_conaf', this)" class="accent-purple-500 w-4 h-4 cursor-pointer">
                                <div class="w-3 h-3 rounded bg-emerald-700"></div>
                                <span class="text-xs text-purple-300">CONAF SIT (SNASPE & Incendios WMS)</span>
                            </div>
                            <span class="text-[9px] bg-purple-950 text-purple-300 px-1.5 py-0.5 rounded border border-purple-800">WMS</span>
                        </label>
                    </div>
                </div>
            </div>
        `;


        // Modals
        function openModal() {
            document.getElementById('exec-modal').classList.remove('hidden');
            document.getElementById('exec-modal').classList.add('flex');
        }
        function closeModal() {
            document.getElementById('exec-modal').classList.add('hidden');
            document.getElementById('exec-modal').classList.remove('flex');
        }

        // Formal Report Download
        function downloadFormalReport() {
            const date = new Date().toISOString().split('T')[0];
            const content = `
================================================================================
REPÚBLICA DE CHILE - DOSSIER INSTITUCIONAL
SISTEMA DE SOPORTE DE DECISIÓN ESPACIAL (SDSS) - AGROTWIN REGIONAL
================================================================================
FECHA: ${date}
UBICACIÓN: Cuenca Maule Sur (Parral - Retiro)
ÁREA DE ESTUDIO: 122,070 Hectáreas
PROYECTO: Fundo Meniel (Keyline)

1. RETORNO FINANCIERO Y OPERATIVO
--------------------------------------------------------------------------------
- CAPEX Inicial: $48,500,000 CLP (Diseño Keyline + 5 Nodos IoT)
- TIR Anual Proyectada: 18.6%
- Período de Recuperación (Payback): 3.8 Años
- Ahorro Energético (Bombeo): -$8,200,000 CLP/Año

2. SEGURIDAD HÍDRICA Y RESILIENCIA
--------------------------------------------------------------------------------
- Capacidad Tranque Acumulador: 18,500 m³
- Tasa de Infiltración de Suelo Mejorada: 320 L/s
- Autonomía Hídrica: 42 Días continuos
- Mitigación de Inundaciones (Peak): -3.2%
- Estado Actual de Humedad (FDR Promedio): ~35.8% VWC

3. RESILIENCIA AL FUEGO (PIRO-ESTRATÉGICO)
--------------------------------------------------------------------------------
- Fire Weather Index (FWI) Local: Riesgo Controlado (Verde)
- Comparativa FWI Monocultivos Aledaños: Riesgo Alto (Rojo)
- Barrera Verde Activa: 2.4 km perimetral (Peumo, Quillay) hidratada
- Valor de Activo Resguardado (Pérdida Evitada): $140,000,000 CLP

4. GOBERNANZA, ESG Y GESTIÓN COMUNITARIA
--------------------------------------------------------------------------------
- Vehículo de Inversión: Meniel SpA
- Participación Local: Cooperativa de Agua Viva
- Impacto Social Directo: 30 Familias rurales
- Monitoreo y Reporte (MRV): Tecnología Blockchain
- Certificación de Carbono y Agua: En proceso (Verra/Gold Standard)

5. RED CENTINELA LOCAL (GROUND-TRUTH MESH)
--------------------------------------------------------------------------------
- Malla IoT KioT Predial: 5 Nodos in situ (FDR-01 Cerezos, FDR-02 Avellano, FDR-03 Keyline, FDR-04 PRV, Piezómetro Tranque)
- Red Pública Oficial Enlazada: 4 Estaciones (INIA Retiro, DGA Río Longaví, DMC Parral Centro, DGA Embalse Bullileo)
- Caudal Oficial Longaví: 185 m³/s (Nivel 2.15m)
- Reserva Embalse Bullileo: 84.2 Hm³ (78% de capacidad)

6. MODELAMIENTO MICRO-ATMOSFÉRICO LOCAL
--------------------------------------------------------------------------------
- Viento Puelche (Efecto Foehn): 38 km/h E-NE, compresión adiabática ladera andina
- Regla 30-30-30: Temp >30°C, HR <30%, Viento >30 km/h (Alerta de desecación foliar y piro-riesgo)
- Mitigación Foehn: Barrera verde perimetral de Peumo/Quillay (62% amortiguación)
- Drenaje Catabático Nocturno: Enfriamiento radiativo a las 05:30 AM (-2.4°C bajo cota 170m)
- Evapotranspiración Atmosférica ETo: 5.1 mm/día (Penman-Monteith)

7. ESTRATEGIA GANADERA TERRITORIAL (PASTOREO RACIONAL VOISIN)
--------------------------------------------------------------------------------
- Carga Animal Regional: 1.8 UGM/ha en pasturas polifíticas perennes
- Tiempo de Reposo Forrajero: 42 Días (Curva sigmoidea óptima de rebrote)
- Biociclado de Nutrientes: +4.2 kg MO/m² en dos temporadas por deyección animal
- Retención Hídrica Adicional: +144,000 Litros/ha por cada 1% de aumento de Materia Orgánica
- Cortafuegos Pastoriles Vivos: Desbroce perimetral biológico en franjas de 25m

